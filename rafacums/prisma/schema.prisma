// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  // relationMode = "prisma" // Optional: Add if using Prisma Accelerate/Pulse later
}

model User {
  id            String          @id @default(cuid())
  name          String?
  username      String?         @unique // Make username unique if required for login
  email         String?         @unique // Keep email unique if used
  emailVerified DateTime?
  hashedPassword String?         // Store hashed password here
  image         String?
  role          UserRole        @default(USER) // Add Role enum for authorization
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

// Auth.js Adapter Models (Recommended for full features)
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Enum for User Roles
enum UserRole {
  USER
  ADMIN
}

model UniformItem {
  id            String      @id @default(cuid())
  // name          String      // e.g., "Wedgewood Shirt", "No 2 SD Jacket", "Beret"
  type          ItemType    // Use an Enum for categories
  size          String?     // e.g., "Medium", "10L", "96cm", "58"
  serialNumber  String?     @unique // Optional, only if items have unique serial numbers
  condition     Condition   @default(GOOD) // Use an Enum for condition
  // assigneeName  String?     // Name/ID of the cadet or staff it's issued to (simple approach)
  // assigneeId String?    // Alternatively, link to a User.id if assignees are Users in your system
  // user        User?       @relation(fields: [assigneeId], references: [id]) // Relation if using assigneeId
  location      String?     // e.g., "Main Store", "Cadet Smith", "Rack 5"
  notes         String?     @db.Text // For longer notes
  addedById     String?     // Optional: ID of the user who added the item
  // addedBy    User?      @relation("AddedItems", fields: [addedById], references: [id]) // Optional relation

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([type]) // Add indexes to columns you filter/sort by often
  @@index([condition])
}

enum ItemType {
  MENS_WEDGEWOOD_SHIRT
  MENS_WORKING_BLUES_SHIRT
  LADIES_WEDGEWOOD_SHIRT
  LADIES_WORKING_BLUES_SHIRT
  MENS_TROUSERS
  LADIES_TROUSERS
  JUMPER
  GELTEX
  BERET
  BLUE_GREY_BELT
  BRASSARD
  COVERALLS
  SOCKS
  GLOVES
  OTHER
}

enum Condition {
  NEW
  GOOD
  FAIR
  POOR
  UNSERVICEABLE
}